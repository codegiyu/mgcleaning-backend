# pino level: trace, debug, info, warn, error, fatal, or silent.
LOG_LEVEL=info
API_PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

DATABASE_URL=postgres://mgcleaning:mgcleaning-local@localhost:5432/mgcleaning
REDIS_URL=redis://localhost:6379

# Use SMTP with local Mailpit for development; Coolify uses Resend in production.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=notifications@example.com
# Replace with the M&G inbox before production. Local messages are captured by Mailpit.
INQUIRY_NOTIFICATION_TO=inquiries@example.com
INQUIRY_SECURITY_SECRET=development-inquiry-security-secret
# Set to the number of trusted reverse-proxy hops in production. Keep 0 for direct local requests.
TRUST_PROXY_HOPS=0
INQUIRY_MAX_BODY_BYTES=32768
INQUIRY_RATE_LIMIT_WINDOW_SECONDS=900
INQUIRY_RATE_LIMIT_PER_WINDOW=5
INQUIRY_RATE_LIMIT_DAY_SECONDS=86400
INQUIRY_RATE_LIMIT_PER_DAY=20
INQUIRY_IDENTITY_LIMIT_PER_DAY=3
INQUIRY_FINGERPRINT_TTL_SECONDS=1800
INQUIRY_MAX_DATE_DAYS=365
INQUIRY_MAX_EMAIL_ATTEMPTS=5
TURNSTILE_MODE=off
TURNSTILE_SECRET_KEY=
TURNSTILE_TIMEOUT_MS=3000
# Cloudflare R2 media storage. Uploads return 503 until all five values are set; production refuses to start without them.
# Use a bucket-scoped API token (Object Read & Write on this bucket only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# One bucket serves every environment; the prefix keeps their objects apart.
R2_FOLDER_PREFIX=development-files
# Public base URL of the bucket's custom domain, e.g. https://media.example.com (no trailing slash).
R2_PUBLIC_URL=
MEDIA_MAX_UPLOAD_BYTES=5242880
# Shared secret (32+ characters) for signed website cache purges; must match the web app's REVALIDATE_SECRET.
# Without it purges stay queued and public blog pages refresh on their hourly backstop. Required in production.
REVALIDATE_SECRET=
# Optional; defaults to ${FRONTEND_ORIGIN}/api/revalidate.
FRONTEND_REVALIDATE_URL=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
